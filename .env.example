# copy to .env (scripts/setup_db.sh generates one with random passwords)
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=shopdb
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me
SHOP_APP_PASSWORD=change-me
MONITOR_COLLECTOR_PASSWORD=change-me
MONITOR_READER_PASSWORD=change-me
COLLECT_INTERVAL_SECONDS=60
# Docker Compose only (docker compose --profile grafana up -d)
GRAFANA_ADMIN_PASSWORD=change-me
